    version = "0.0.0",
)

bazel_dep(name = "elemental2", version = "1.3.2")
bazel_dep(name = "j2cl", version = "20260402")
archive_override(
    module_name = "j2cl",
    integrity = "sha256-Ny6r8kYwbMjLWY+39VKzGGHerH1xOIWBRvhxO1gT8iQ=",
    strip_prefix = "j2cl-78d44e6e7c2c2517e654f63405a2bc61e2462c4c",
